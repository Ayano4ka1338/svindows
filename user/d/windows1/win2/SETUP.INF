; This file is in the current drive and directory when SETUP is run
; (WIN.CNF and WIN.INI have to be on the current drive also).
; It may be either on a diskette or on a hard disk or network.

; It is divided into sections, identified by an alphanumeric name
; enclosed in square brackets.

; Comments begin with semicolon, and may follow other text.
; Long lines may be split up between fields of a statement.

; In the sections which list the location of various files, each
; filename is preceded by integers describing the location
; of the files.  The Setup program will prompt the user to insert
; these diskettes when the files are needed.  Files on a hard disk
; or network may be used instead, by placing an entry in the [harddisk]
; section of this file.


; These are information you could find in SETUP.DAT of the old SETUP.
; They have to be changed for a runtime version or Windows/386

[data]
;  Name of the Windows startup program, may be changed for a runtime version
;  WIN86.COM determines setup for Windows/386
  ("WIN.COM")
;  Name of the application executable file if it is a runtime version
  ("")
;  Default directory for installing Windows, MUST include a drive letter
  ("C:\WINDOWS")
;    -- screen messages --
;  short name of the program
  ("Windows")
;  long name of the program (including version)
  ("Microsoft Windows Version 2")
;  What you have to type in to start the program
  ("WIN")
;  Name of a program invoked after completing setup
  ("")


; Here are the names of the disks Setup can prompt for.
; There must be a disk name for each disk number used

[diskette]
  ("Setup and Build Disk")
  ("Displays Disk")
  ("Utilities Disk")
  ("Fonts Disk")
  ("Desktop Applications and Microsoft Write Disk")


; This defines where drivers or modules universal to all systems
; are to be found. The entries -- KERNEL, GDI, USER, and MSDOS --
; are in fixed order
; KERNEL has to be on one of the first disks, in no case on a disk
; with a higher number than GDI, USER, MSDOS and MSDOSD

[windows]
  (1:Kernel.Exe)
  (1:Gdi.Exe)
  (1:User.Exe)
  (1:Msdos.Exe)


[system]
; The various MSDOSD.EXE, SYSTEM.DRV, SOUND.DRV, COMM.DRV, WINOLDAP.MOD,
; SPOOLER.EXE etc. files are listed here.
;
; These are the drivers which may vary from system to system,
; but are selected only by the [machine] menu -- they do not have
; special menus for their selection.

  (1:system.drv)

  (1:msdosd.exe)

  (1:sound.drv)

  (1:comm.drv)

  (2:winoldap.mod)

  (2:spooler.exe)

  (1:attsys.drv)
  (1:tandysnd.drv)

[display]

; The string following the driver description specifies the screen
; resolution.  It is used to match the system and OEM character sets
; with the display selection.

	(2:CGA.DRV, "IBM (or 100% compatible) CGA (Color/Graphics Adapter)",
		"200,96,48")
	(2:EGAHIRES.drv, "IBM (or 100% compatible) EGA (> 64K) with Enhanced Color Display",
		"133,96,72")
	(2:EGAMONO.drv, "IBM EGA with High-Resolution Monochrome Display",
		"133,96,72")
	(2:EGAHIBW.drv, "IBM EGA with Enhanced Color Display (black and white)",
		"133,96,72")
	(2:EGALORES.drv, "IBM EGA with Enhanced Color Display or PC Color Display (color)",
		"200,96,48")
	(2:IBMPS230.drv, "IBM MCGA (Multi-Color Graphics Array)","100,96,96")
	(2:IBMPS250.drv, "IBM (or 100% compatible) VGA (Video Graphics Array)",
		"100,96,96")
	(2:HERCULES.drv, "Hercules Adapter with High-Resolution Monochrome Display",
		"133,96,72")
	(2:attdeb.drv, "AT&T Color DEB (Display Enhancement Board)","120,96,80")
	(2:attdc.drv, "AT&T Monochrome (Indigenous Display Board)","120,96,80")
	(2:compaq.drv, "Compaq Portable Plasma","100,96,96")
	(2:tandydsp.drv, "Tandy 1000 Color","200,96,48")



[logos]

; this section defines the locations of logo code files, corresponding
; to the display drivers. They have the .LGO extension.
; Aliasing may be done here to save diskette space -- if 2 filenames
; are given, the FIRST one is the actual one used.
; The root of the LAST filename is the same as the root of the selected
; display driver's filename.

	(2:cga.lgo)
	(2:cga.lgo,egalores.lgo)
	(2:cga.lgo,egahires.lgo)
	(2:cga.lgo,egahibw.lgo)
	(2:egamono.lgo)
	(2:hercules.lgo)
	(2:cga.lgo,ibmps230.lgo)
	(2:cga.lgo,ibmps250.lgo)
	(2:cga.lgo,ibm8514.lgo)
	(2:attdc.lgo)
	(2:attdc.lgo,attdeb.lgo)
	(2:attdc.lgo,compaq.lgo)
	(2:tandydsp.lgo)


[oemlogos]

; This section contains the logo data files, specific to each OEM
; or computer system.  They are selected by selecting a system.
; They have the .LGD extension.

	(1:mslogo.lgd)

[grabber]

; this section defines the locations of the screen grabber files.
; (These files will be renamed to WINOLDAP.GRB when copied)
; These files may be aliased, like the .lgo files.

	(2:egahires.grb,egalores.grb)
	(2:egahires.grb)
	(2:egahires.grb,egahibw.grb)
	(2:egamono.grb)
	(2:cga.grb)
	(2:hercules.grb)
	(2:egahires.grb,ibmps230.grb)
	(2:egahires.grb,ibmps250.grb)
