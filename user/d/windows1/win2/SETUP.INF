[machine]

; This section defines default machine selections.  The system
; description from each entry will appear in the initial machine
; selection menu of Setup.

; Each entry contains a descriptive line for the system-selection menu,
; followed by the filenames of the drivers in fixed order.
;
; Care must be taken to associate the correct system and terminal
; fonts with the selection of keyboard driver and display type.
; The whole entry for a system is enclosed in parentheses.
; A printer driver is NOT included in these lists.


("IBM Personal System/2 Model 25 or 30",
	system.drv,				; system driver
	usa.drv,				; keyboard driver
	"Microsoft Mouse connected to PS/2 Mouse Port"	; mouse driver
	IBMPS230.drv,                           ; display driver
	mslogo.lgd,				; OEM-specific LOGO data
	sound.drv,				; sound driver
	comm.drv,				; communications driver
	fontsq.fon,                             ; system ANSI font
	fontsqus.fon,                           ; terminal (OEM) font
	msdosd.exe,				; MSDOSD (format/sys)
	winoldap.mod,				; WINOLDAP
	spooler.exe)				; spooler

("IBM Personal System/2 Model 50, 60, or 80",
	system.drv,				; system driver
	usa.drv,				; keyboard driver
	"Microsoft Mouse connected to PS/2 Mouse Port"	; mouse driver
	IBMPS250.drv,				; display driver
	mslogo.lgd,				; OEM-specific LOGO data
	sound.drv,				; sound driver
	comm.drv,				; communications driver
	fontsq.fon,				; system ANSI font
	fontsqus.fon,				; terminal (OEM) font
	msdosd.exe,				; MSDOSD (format/sys)
	winoldap.mod,				; WINOLDAP
	spooler.exe)				; spooler

("IBM PC, XT, AT (or 100% compatible)",
