	(1:fonthi.fon,"Small System Font (CGA)","133,96,72")
	(1:fontlo.fon,"Small System Font (EGA)","200,96,48")
	(1:fontsq.fon,"Medium System Font (AT&T)","120,96,80")
	(1:fontsq.fon,"Medium System Font (VGA)","100,96,96")


[oemfonts]

; The selection of the OEM (Terminal) font depends on both the screen
; resolution and the OEM character set (determined by the selection of
; keyboard driver).

; In translated versions, the "standard" character sets should be listed
; first, with the following exceptions:
;
;	Denmark and Norway: list Nordic character set first
;       Portugese system: list Portugese character set first
;       Spanish systems: list Spanish National character set
;		first, followed by international (standard) set.
;
	; standard OEM character set
	(1:fontlous.fon,"Small Terminal Font (USA/Europe - CGA)","200,96,48",1)
	(1:fonthius.fon,"Small Terminal Font (USA/Europe - EGA)","133,96,72",1)
	(1:fontsqus.fon,"Large Terminal Font (USA/Europe - AT&T)","120,96,80",1)
	(1:fontsqus.fon,"Large Terminal Font (USA/Europe - VGA)","100,96,96",1)

	; Nordic OEM character set
;       (9:fontlono.fon,"Terminal Font (Nor/Den) for CGA","200,96,48",2)
;       (9:fonthino.fon,"Terminal Font (Nor/Den) for EGA, Hercules",
;               "120,96,72",2)
;       (9:font40no.fon,"Terminal Font (Nor/Den) for 640x400","120,96,80",2)

	; Portugese OEM character set
