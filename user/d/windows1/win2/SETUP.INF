;       (9:fonthipo.fon,"Terminal Font (Port.) for 640x350","133,96,72",3)
;       (9:font40po.fon,"Terminal Font (Port.) for 640x400","120,96,80",3)

;       ; Spanish National OEM character set for Olivetti
;       (9:fontlosp.fon,"Terminal Font (Spain) for CGA", "200,96,48",4)
;       (9:fonthisp.fon,"Terminal Font (Spain) for 640x350","133,96,72",4)
;       (9:font40sp.fon,"Terminal Font (Spain) for 640x400","120,96,80",4)


