	(2:attdc.grb)
	(2:attdc.grb,attdeb.grb)
	(2:cga.grb,tandydsp.grb)
	(2:cga.grb,compaq.grb)


; For Windows/386 you must specify in the next two sections the location
; of the display dependent files with extention .3EX and .386 which are renamed
; to WIN386.EXE and WIN386.386. These lines have the same format as [logos].

[386EXE]

[386]

