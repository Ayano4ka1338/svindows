	msdosd.exe,				; MSDOSD (format/sys)
	winoldap.mod,				; WINOLDAP
	spooler.exe)				; spooler

  ("Tandy 1000",
	system.drv,				; system driver
	tandykbd.drv,				; keyboard driver
	"Microsoft Mouse (Bus or Serial)",	; mouse driver
	tandydsp.drv,				; display driver
	mslogo.lgd,				; OEM-specific LOGO data
	tandysnd.drv,				; sound driver
	comm.drv,				; communications driver
	fontlo.fon,				; system ANSI font
	fontlous.fon,				; terminal (OEM) font
	msdosd.exe,				; MSDOSD (format/sys)
	winoldap.mod,				; WINOLDAP
	spooler.exe)				; spooler

[harddisk]

; This section lists diskette numbers which represent hard-disk
; directories instead of removable diskettes.
; The path names MUST be enclosed in double quotes and
; MUST end with a '\' or ':'

;        (1 = "c:\winsetup\disk1\")
;        (2 = "c:disk2\")
